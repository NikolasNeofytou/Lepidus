{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "operator-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/portal",
      "port": 5173
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--clear", "--port", "8081"],
      "cwd": "${workspaceFolder}",
      "port": 8081
    }
  ]
}
